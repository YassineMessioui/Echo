# Copy to .env (git-ignored) and fill in the key for the provider you use.
# echo-clips loads it automatically; variables set in your shell take precedence.
# See docs/llm-providers.md.

# GROQ_API_KEY=
# MISTRAL_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=

# Overrides the provider-specific variable above:
# ECHO_LLM_API_KEY=
